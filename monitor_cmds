#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   ./monitor_cmds                         Monitor the newest run under runs/.
#   ./monitor_cmds runs/ufo_fb_g1          Monitor a specific run directory.
#   ./monitor_cmds runs/ufo_fb_g1 --once   Print one snapshot and exit.
#   ./monitor_cmds --no-gpu                Skip nvidia-smi queries.

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "$PROJECT_DIR"

export PATH="$HOME/.local/bin:$PATH"

monitor_python="${MONITOR_PYTHON:-}"
if [[ -z "$monitor_python" ]]; then
  for candidate in \
    "$PROJECT_DIR/.venv/bin/python" \
    "$HOME/conda-envs/bfm/bin/python"; do
    if [[ -x "$candidate" ]] && "$candidate" -c 'import rich' >/dev/null 2>&1; then
      monitor_python="$candidate"
      break
    fi
  done
fi

if [[ -n "$monitor_python" ]]; then
  exec "$monitor_python" -m humanoidverse.monitor "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run --no-sync python -m humanoidverse.monitor "$@"
else
  exec python -m humanoidverse.monitor "$@"
fi
